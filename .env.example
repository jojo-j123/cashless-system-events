# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashless
# Separate database used by `npm test`. Wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashless_test

# --- Secrets --------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
# Signs QR payloads and terminal requests. NEVER exposed to the browser.
APP_SECRET=replace-me-with-openssl-rand-base64-48

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
# Comma-separated origins allowed to submit mutations (CSRF origin check).
APP_ORIGIN=http://localhost:3000
# Which proxy header may be trusted for the client IP: cloudflare | forwarded | none.
# Rate limiting keys off this, so a wrong value silently weakens the login limiter.
#   cloudflare  behind Cloudflare, with the origin locked to Cloudflare only
#   forwarded   behind exactly one reverse proxy (Railway, Fly, Render, nginx)
#   none        directly exposed; no forwarded header is trustworthy
TRUSTED_PROXY=forwarded
# Enables the dev NFC simulator UI. MUST be false in production.
NEXT_PUBLIC_ENABLE_NFC_SIMULATOR=true
